---
import { getMedia } from '../lib/data';
const { lang = 'en', globalSettings } = Astro.props;

const footerCopyright = globalSettings?.footerText || "© 2024 ASN Weld & Inspection Network. All rights reserved. Brema Headquarters.";
const logoUrl = getMedia(globalSettings?.logo, globalSettings);
const logoText = globalSettings?.logoText || "ASN Weld & Inspection Network";

const desc = globalSettings?.footerDesc || "Professional engineering network specializing in the coordination and supervision of welding processes and NDT testing. Headquartered in Bremen, European reach.";
const servicesLabel = globalSettings?.footerServicesLabel || "Services";
const legalLabel = globalSettings?.footerLegalLabel || "Legal";
const weldingLabel = globalSettings?.weldingLabel || "Welding Coordination";
const ndtLabel = globalSettings?.ndtLabel || "NDT Testing";
const corrosionLabel = globalSettings?.corrosionLabel || "Anti-Corrosion Protection";
const qaqcLabel = globalSettings?.qaqcLabel || "QA/QC Support";

const getLink = (path) => {
  if (lang === 'en') return path;
  return `/${lang}${path.startsWith('/') ? path : '/' + path}`;
};
---
<footer class="w-full py-12 bg-surface-container-highest border-t border-outline-variant/30">
  <div class="grid grid-cols-1 md:grid-cols-4 gap-gutter px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto">
    <div class="col-span-1 md:col-span-2">
      <a class="font-display text-headline-sm font-bold text-on-surface block mb-6 hover:text-primary transition-colors" href={getLink("/")}>
        {logoUrl ? (
          <img src={logoUrl} alt={logoText} class="h-24 w-auto object-contain" />
        ) : (
          logoText
        )}
      </a>
      <p class="text-on-surface-variant max-w-md mb-8 leading-relaxed">
        {desc}
      </p>
      <div class="flex gap-4">
        <a class="w-10 h-10 border border-outline flex items-center justify-center hover:bg-navy hover:text-white transition-all rounded-full shadow-sm" href="#" aria-label="Share">
          <span class="material-symbols-outlined text-sm">share</span>
        </a>
      </div>
    </div>
    <div>
      <h4 class="font-bold mb-6 uppercase text-label-md tracking-wider text-primary">{servicesLabel}</h4>
      <ul class="space-y-3">
        <li><a class="text-on-surface-variant hover:text-primary transition-colors block py-1" href={getLink("/uslugi.html")}>{weldingLabel}</a></li>
        <li><a class="text-on-surface-variant hover:text-primary transition-colors block py-1" href={getLink("/uslugi.html")}>{ndtLabel}</a></li>
        <li><a class="text-on-surface-variant hover:text-primary transition-colors block py-1" href={getLink("/uslugi.html")}>{corrosionLabel}</a></li>
        <li><a class="text-on-surface-variant hover:text-primary transition-colors block py-1" href={getLink("/uslugi.html")}>{qaqcLabel}</a></li>
      </ul>
    </div>
    <div>
      <h4 class="font-bold mb-6 uppercase text-label-md tracking-wider text-primary">{legalLabel}</h4>
      <ul class="space-y-3">
        <li><a class="text-on-surface-variant hover:text-primary transition-colors block py-1" href="#">Privacy Policy</a></li>
        <li><a class="text-on-surface-variant hover:text-primary transition-colors block py-1" href="#">Terms of Service</a></li>
        <li><a class="text-on-surface-variant hover:text-primary transition-colors block py-1" href="#">Compliance</a></li>
        <li><a class="text-on-surface-variant hover:text-primary transition-colors block py-1" href="#">Impressum</a></li>
      </ul>
    </div>
  </div>
  <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop mt-12 pt-8 border-t border-outline-variant/30">
    <p class="text-on-surface-variant text-sm text-center md:text-left font-medium">
      {footerCopyright}
    </p>
  </div>
</footer>
