---
import Layout from '../../layouts/Layout.astro';
import { fetchApi, getMedia } from '../../lib/data';

const pageData = await fetchApi({
  collection: 'experience_page',
  locale: 'de'
});

const attrs = pageData || {};
const title = attrs.title || "Erfahrung";
const seoTitle = attrs.seoTitle || "Erfahrung | ASN Weld & Inspection Network";
const seoDesc = attrs.seoDesc || "Erfahren Sie mehr über unsere Erfahrung und unser technisches Verantwortungsmodell.";

const badge = attrs.badge || "UNSERE IDENTITÄT";
const heroTitle = attrs.heroTitle || "Wissen, Erfahrung, Verantwortung.";
const heroDesc = attrs.heroDesc || "Das ASN Weld & Inspection Network ist ein Expertenteam für die Schweiß- und ZfP-Branche. Wir liefern komplette technische Lösungen nach höchsten Ingenieursstandards.";

const modelTitle = attrs.modelTitle || "Kooperationsmodell: Werkvertrag & Outsourcing";
const modelDesc = attrs.modelDesc || "<p class=\"mb-4\">Unser Geschäftsmodell basiert auf Werkverträgen und dem vollständigen Outsourcing technischer Prozesse. Wir übernehmen die volle Verantwortung für das Endergebnis des Projekts, die Schweißnahtqualität und die Einhaltung der ZfP-Normen.</p>";

const s1Val = attrs.stat1Val || "15+";
const s1Lbl = attrs.stat1Lbl || "Jahre in der Offshore-Industrie";
const s2Val = attrs.stat2Val || "100%";
const s2Lbl = attrs.stat2Lbl || "Konformität mit EN/ISO";
const s3Val = attrs.stat3Val || "50+";
const s3Lbl = attrs.stat3Lbl || "Abgeschlossene Großprojekte";

const img1 = getMedia(attrs.image1, pageData) || "https://lh3.googleusercontent.com/aida-public/AB6AXuBBrGiolNSi1aj_eMj1dC52n6Fhn9p1dzew3rJjbium6Hcp0su75LUGgByvEvfD7gzxGp6dkOqMh4sDXy5yUXgpQujccUM6Igb5FOBweEzo5oiELmnPTZFp3HeqCcWxzH0JlyKhYpKb8AN_yCCzbt_697NM4eYFHYx68s0z4LxT19W_czhbgEk9HExO1APRQli5cfWmoCZdipk2ZqcVJQfAEZCl3VJwEXF1keSSA4XtPYcoMlMFW7uZeRnGsvWpOY63Kbj49EQHhV8";
const hqImg = "https://lh3.googleusercontent.com/aida-public/AB6AXuAdqFr86OltPylJyJf6vgZTVDTHJhEFfvb6ORZ-L7YL9hprkzbr3hdjRBiSG6_6n8I3tb20w3oRRVOkrpAzqW-u1OSNcSvJ0uaR2b_68qRH0HGJXgdqt1AOF8UvbKcnBEN99JuPQj7IaDsnDmNeqvAC59rL4u3bKq7ugRGDZ3OO0VaySi7Eyr-v-r6WZKftMgMzcbOIHMfZBh027NBW2hT2GmaNifIAbOHkGnuhAqicMIu7G2EssENST3VHpP1OqY5QvrZO8nDgd4c";
---
<Layout title={title} seoTitle={seoTitle} seoDescription={seoDesc} lang="de">
  <!-- Hero Section -->
  <section class="relative py-20 md:py-28 bg-navy text-white overflow-hidden border-b border-outline-variant/30">
    <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop relative z-10">
      <div class="max-w-3xl">
        <span class="font-display text-sm font-bold text-secondary tracking-widest uppercase mb-4 block">{badge}</span>
        <h1 class="font-display text-4xl md:text-6xl font-bold mb-8 leading-tight" set:html={heroTitle} />
        <p class="font-body-md text-lg text-gray-300 mb-10 border-l-4 border-secondary pl-6 leading-relaxed" set:html={heroDesc} />
      </div>
    </div>
  </section>

  <!-- Stats Banner -->
  <section class="bg-surface-container py-12 border-b border-outline-variant/30">
    <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-center">
        <div class="p-6 bg-surface rounded-xl border border-outline-variant/20 shadow-sm">
          <div class="font-display text-4xl md:text-5xl font-extrabold text-primary mb-2">{s1Val}</div>
          <div class="text-sm font-bold text-on-surface-variant uppercase tracking-wider">{s1Lbl}</div>
        </div>
        <div class="p-6 bg-surface rounded-xl border border-outline-variant/20 shadow-sm">
          <div class="font-display text-4xl md:text-5xl font-extrabold text-primary mb-2">{s2Val}</div>
          <div class="text-sm font-bold text-on-surface-variant uppercase tracking-wider">{s2Lbl}</div>
        </div>
        <div class="p-6 bg-surface rounded-xl border border-outline-variant/20 shadow-sm">
          <div class="font-display text-4xl md:text-5xl font-extrabold text-primary mb-2">{s3Val}</div>
          <div class="text-sm font-bold text-on-surface-variant uppercase tracking-wider">{s3Lbl}</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Cooperation Model Section -->
  <section class="py-24 bg-surface">
    <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-16 items-center">
        <div>
          <h2 class="font-display text-3xl md:text-4xl font-bold text-primary mb-6">{modelTitle}</h2>
          <div class="font-body-md text-base text-on-surface-variant mb-8 leading-relaxed prose max-w-none" set:html={modelDesc} />
          <div class="space-y-4">
            <div class="flex items-start gap-4 p-5 bg-surface-container-low rounded-xl border border-outline-variant/30">
              <span class="material-symbols-outlined text-secondary text-3xl">assignment_turned_in</span>
              <div>
                <h4 class="font-display font-bold text-primary mb-1">PROJEKTORIENTIERUNG</h4>
                <p class="text-sm text-on-surface-variant">Fokus auf die Lieferung konkreter technischer Meilensteine in vereinbarter Zeit und Qualität.</p>
              </div>
            </div>
            <div class="flex items-start gap-4 p-5 bg-surface-container-low rounded-xl border border-outline-variant/30">
              <span class="material-symbols-outlined text-secondary text-3xl">verified_user</span>
              <div>
                <h4 class="font-display font-bold text-primary mb-1">QUALITÄTSGARANTIE</h4>
                <p class="text-sm text-on-surface-variant">Eigene Ingenieuraufsicht und zertifizierte Prüfer in jeder kritischen Projektphase präsent.</p>
              </div>
            </div>
          </div>
        </div>
        <div class="relative aspect-square rounded-2xl overflow-hidden shadow-xl border border-outline-variant/30">
          <img class="w-full h-full object-cover" src={img1} alt={modelTitle} />
          <div class="absolute bottom-6 left-6 right-6 bg-navy/95 backdrop-blur-md p-6 rounded-xl border border-white/10 hidden sm:block">
            <p class="text-white font-display text-lg font-bold">0% Leiharbeitsfirma<br/><span class="text-secondary font-normal">100% Technische Verantwortung</span></p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Why ASN Section -->
  <section class="py-20 bg-surface-container-low border-t border-outline-variant/30">
    <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop">
      <div class="text-center mb-14">
        <h2 class="font-display text-3xl font-bold text-primary mb-3">Warum ASN?</h2>
        <p class="text-on-surface-variant max-w-xl mx-auto">Unser Wettbewerbsvorteil basiert auf praktischer Industrieerfahrung und kompromissloser Qualität.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="bg-surface p-8 rounded-xl border border-outline-variant/30 shadow-sm">
          <div class="w-12 h-1 bg-secondary mb-6"></div>
          <h3 class="font-display text-xl font-bold text-primary mb-3">Flexibilität</h3>
          <p class="text-sm text-on-surface-variant leading-relaxed">Wir passen die Größe und Kompetenzen des Ingenieurteams an die jeweilige Projektphase an und minimieren so Fixkosten.</p>
        </div>
        <div class="bg-surface p-8 rounded-xl border border-outline-variant/30 shadow-sm">
          <div class="w-12 h-1 bg-secondary mb-6"></div>
          <h3 class="font-display text-xl font-bold text-primary mb-3">Zuverlässigkeit</h3>
          <p class="text-sm text-on-surface-variant leading-relaxed">Jeder Bericht und jede Inspektion unter der Marke ASN durchläuft eine strenge interne Prüfung nach EN/ISO-Normen.</p>
        </div>
        <div class="bg-surface p-8 rounded-xl border border-outline-variant/30 shadow-sm">
          <div class="w-12 h-1 bg-secondary mb-6"></div>
          <h3 class="font-display text-xl font-bold text-primary mb-3">Industriepraxis</h3>
          <p class="text-sm text-on-surface-variant leading-relaxed">Unser Wissen ist nicht nur akademisch. Wir stammen direkt aus der Schwer-, Schiffbau- und Offshore-Industrie.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Headquarters Section -->
  <section class="py-20 bg-navy text-white">
    <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-stretch rounded-2xl overflow-hidden border border-white/10 shadow-2xl">
        <div class="bg-cover bg-center min-h-[350px]" style={`background-image: url('${hqImg}')`}></div>
        <div class="p-10 md:p-16 flex flex-col justify-center bg-navy">
          <span class="text-secondary font-bold text-xs uppercase tracking-wider mb-2">Zentrale Operationen</span>
          <h2 class="font-display text-3xl font-bold text-white mb-6">Hauptsitz Bremen</h2>
          <p class="text-gray-300 mb-8 leading-relaxed">
            Unser strategisches Leitstand befindet sich in Bremen, einem der wichtigsten maritimen und industriellen Knotenpunkte Europas. Von hier aus koordinieren wir Einsätze auf den europäischen Märkten.
          </p>
          <div class="flex items-center gap-6 pt-6 border-t border-white/10">
            <div>
              <span class="text-xs font-bold uppercase text-gray-400 block mb-1">Standort</span>
              <span class="text-white font-bold">Bremen, Deutschland</span>
            </div>
            <div class="w-px h-10 bg-white/20"></div>
            <div>
              <span class="text-xs font-bold uppercase text-gray-400 block mb-1">Qualitätsstandards</span>
              <span class="text-secondary font-bold">ISO & ASME Zertifiziert</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
