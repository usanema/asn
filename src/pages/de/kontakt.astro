---
import Layout from '../../layouts/Layout.astro';
import { fetchApi } from '../../lib/data';

const pageData = await fetchApi({
  collection: 'contact_page',
  locale: 'de'
});

const attrs = pageData || {};
const title = attrs.title || "Kontakt";
const seoTitle = attrs.seoTitle || "Kontakt | ASN Weld & Inspection Network";
const seoDesc = attrs.seoDesc || "Kontaktieren Sie unser Ingenieurteam in Bremen.";

const badge = attrs.badge || "Hauptsitz Bremen, Deutschland";
const heroTitle = attrs.heroTitle || "Kontaktieren Sie uns";
const heroDesc = attrs.heroDesc || "Wir sind Ihr strategischer Partner für Schweißkoordination, ZfP-Prüfungen und Korrosionsschutzmanagement. Wir laden Sie zum technischen Dialog ein.";

const formTitle = attrs.formTitle || "Kontaktformular";
const addressTitle = attrs.addressTitle || "Adresse des Hauptsitzes";
const addressText = attrs.addressText || "ASN Weld & Inspection Network GmbH<br/>Am Wall 120<br/>28195 Bremen, Deutschland";
const emailText = attrs.emailText || "contact@asn-network.de";
const phoneText = attrs.phoneText || "+49 (0) 421 123 4567";

const mapImg = "https://lh3.googleusercontent.com/aida-public/AB6AXuBVWmA8wM3MxEXmQ9Y2wEOiG8OGB6YWeZWuw7WVdnr_itAAshRpJ31ULVbofn_fl5bbpaalep6vqVYaG3_UwPD5EgW3V91P0awyRLjMRiU-tXIWKvgcMNvjz-FVbtJ_pC_vEXyQZwHpNXigv39IpxU2_cusbMD19NRdw5b0UuXQ1o7zt34A8GnQziGUOd8tDOK_RLuh0sOWhO1WOeSJ7fsdenBaZP1FbsDgTqAHhPa6hWZIT_1CJlgeoZv0aQ1wBD_PHQE3sdO668I";
---
<Layout title={title} seoTitle={seoTitle} seoDescription={seoDesc} lang="de">
  <!-- Hero Section -->
  <section class="relative py-20 md:py-28 bg-navy text-white overflow-hidden border-b border-outline-variant/30">
    <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop relative z-10">
      <div class="max-w-3xl">
        <span class="font-display text-sm font-bold text-secondary tracking-widest uppercase mb-4 block">{badge}</span>
        <h1 class="font-display text-4xl md:text-6xl font-bold mb-6 leading-tight" set:html={heroTitle} />
        <p class="font-body-md text-lg text-gray-300 max-w-2xl leading-relaxed" set:html={heroDesc} />
      </div>
    </div>
  </section>

  <!-- Main Content: Bento Layout -->
  <section class="py-16 md:py-24 max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
      <!-- Contact Form Card -->
      <div class="lg:col-span-7 bg-surface border border-outline-variant/30 p-8 md:p-12 rounded-2xl shadow-sm">
        <h2 class="font-display text-2xl md:text-3xl font-bold text-primary mb-8">{formTitle}</h2>
        <form class="space-y-6" onsubmit="event.preventDefault(); alert('Nachricht erfolgreich gesendet! Unser Team wird sich in Kürze bei Ihnen melden.');">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="space-y-2">
              <label class="font-bold text-xs text-on-surface uppercase tracking-wider block">Voller Name</label>
              <input required class="w-full bg-surface-container-low border border-outline-variant/30 focus:border-primary p-3.5 rounded-lg text-sm outline-none transition-all" placeholder="Max Mustermann" type="text"/>
            </div>
            <div class="space-y-2">
              <label class="font-bold text-xs text-on-surface uppercase tracking-wider block">E-Mail-Adresse</label>
              <input required class="w-full bg-surface-container-low border border-outline-variant/30 focus:border-primary p-3.5 rounded-lg text-sm outline-none transition-all" placeholder="max@unternehmen.de" type="email"/>
            </div>
          </div>
          <div class="space-y-2">
            <label class="font-bold text-xs text-on-surface uppercase tracking-wider block">Anfragethema</label>
            <div class="relative">
              <select class="w-full bg-surface-container-low border border-outline-variant/30 focus:border-primary p-3.5 rounded-lg text-sm outline-none transition-all appearance-none">
                <option value="welding">Schweißkoordination & Überwachung (IWE/EWE)</option>
                <option value="ndt">Zerstörungsfreie Prüfung (ZfP)</option>
                <option value="corrosion">Korrosionsschutz (FROSIO/NACE)</option>
                <option value="other">Allgemeine technische Anfrage</option>
              </select>
              <span class="material-symbols-outlined absolute right-3.5 top-1/2 -translate-y-1/2 pointer-events-none text-on-surface-variant">expand_more</span>
            </div>
          </div>
          <div class="space-y-2">
            <label class="font-bold text-xs text-on-surface uppercase tracking-wider block">Nachrichtendetails</label>
            <textarea required class="w-full bg-surface-container-low border border-outline-variant/30 focus:border-primary p-3.5 rounded-lg text-sm outline-none transition-all" placeholder="Beschreiben Sie den Projektumfang, den Standort und die technischen Anforderungen..." rows="5"></textarea>
          </div>
          <div class="flex items-center gap-3 pt-2">
            <input required class="rounded border-outline-variant/30 text-primary w-4 h-4 cursor-pointer" id="consent_de" type="checkbox"/>
            <label class="text-xs text-on-surface-variant cursor-pointer select-none" for="consent_de">Ich stimme der Verarbeitung meiner personenbezogenen Daten gemäß der Datenschutzerklärung zu.</label>
          </div>
          <button class="w-full md:w-auto bg-primary text-white px-8 py-4 font-bold rounded-lg hover:bg-secondary transition-all flex items-center justify-center gap-2 shadow-md group" type="submit">
            Nachricht senden
            <span class="material-symbols-outlined group-hover:translate-x-1 transition-transform text-sm">send</span>
          </button>
        </form>
      </div>

      <!-- Info & Map Sidebar -->
      <div class="lg:col-span-5 space-y-8">
        <!-- Contact Info Card -->
        <div class="bg-navy text-white p-8 md:p-10 rounded-2xl shadow-xl border border-white/10">
          <h3 class="font-display text-2xl font-bold mb-8 text-white">{addressTitle}</h3>
          <div class="space-y-8">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-white/10 flex items-center justify-center rounded-lg shrink-0 text-secondary">
                <span class="material-symbols-outlined">call</span>
              </div>
              <div>
                <p class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-1">Telefon</p>
                <a class="font-display text-lg font-bold hover:text-secondary transition-colors" href={`tel:${phoneText}`}>{phoneText}</a>
              </div>
            </div>
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-white/10 flex items-center justify-center rounded-lg shrink-0 text-secondary">
                <span class="material-symbols-outlined">mail</span>
              </div>
              <div>
                <p class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-1">E-Mail</p>
                <a class="font-display text-lg font-bold hover:text-secondary transition-colors" href={`mailto:${emailText}`}>{emailText}</a>
              </div>
            </div>
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-white/10 flex items-center justify-center rounded-lg shrink-0 text-secondary">
                <span class="material-symbols-outlined">location_on</span>
              </div>
              <div>
                <p class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-1">Standort</p>
                <div class="font-display text-base font-bold leading-relaxed text-white" set:html={addressText} />
              </div>
            </div>
          </div>
        </div>

        <!-- Map/Visual Representation -->
        <div class="aspect-video bg-surface-container rounded-2xl overflow-hidden border border-outline-variant/30 relative group shadow-md">
          <img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" src={mapImg} alt="Bremen Karte" />
          <div class="absolute inset-0 bg-navy/40 flex items-center justify-center pointer-events-none">
            <div class="bg-navy text-white px-4 py-2 rounded-full text-xs font-bold flex items-center gap-2 border border-white/20 shadow-xl">
              <span class="material-symbols-outlined text-secondary text-sm">location_on</span>
              HAUPTSITZ BREMEN
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section: Join Network -->
  <section class="bg-surface-container-low py-20 border-t border-outline-variant/30">
    <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop text-center">
      <div class="max-w-3xl mx-auto">
        <h2 class="font-display text-2xl md:text-3xl font-bold text-primary mb-4">Werden Sie Teil unseres Netzwerks</h2>
        <p class="text-on-surface-variant mb-8 leading-relaxed">
          Sind Sie ein zertifizierter ZfP-Prüfer oder erfahrener Schweißkoordinator? Wir suchen spezialisierte Partner für renommierte Industrieprojekte in ganz Europa.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a href="/de/about" class="bg-primary text-white px-8 py-3.5 font-bold text-sm rounded-lg hover:bg-secondary transition-all w-full sm:w-auto shadow-sm">
            Bewerben Sie sich
          </a>
          <a href="/de/uslugi" class="border border-primary text-primary px-8 py-3.5 font-bold text-sm rounded-lg hover:bg-primary hover:text-white transition-all w-full sm:w-auto">
            Für Geschäftspartner
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
