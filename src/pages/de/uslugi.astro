---
import Layout from '../../layouts/Layout.astro';
import { fetchApi, getMedia } from '../../lib/data';

const pageData = await fetchApi({
  collection: 'services_page',
  locale: 'de'
});

const attrs = pageData || {};
const title = attrs.title || "Dienstleistungen";
const seoTitle = attrs.seoTitle || "Dienstleistungen | ASN Weld & Inspection Network";
const seoDesc = attrs.seoDesc || "Umfassende technische Unterstützung in den Bereichen Schweißtechnik, ZfP und Korrosionsschutz.";

const badge = attrs.badge || "PROFESSIONALITÄT & QUALITÄT";
const heroTitle = attrs.heroTitle || "Unsere Dienstleistungen";
const heroDesc = attrs.heroDesc || "Umfassende technische Unterstützung in den Bereichen Schweißtechnik, zerstörungsfreie Prüfung und Korrosionsschutz für die Schwerindustrie und den Energiesektor.";

const p1Title = attrs.pillar1Title || "Schweißkoordination & Überwachung (IWE/EWE)";
const p1Desc = attrs.pillar1Desc || "Vollständige Überwachung von Schweißprozessen gemäß EN ISO 3834, EN 1090 und Offshore-Standards.";
const p1Img = getMedia(attrs.pillar1Image, pageData) || "https://lh3.googleusercontent.com/aida-public/AB6AXuCozDnJai0fc5h24His7_lwuuvRkWNw7ycEntToxRTQvtqihRfEzRqgqf9dkI9NuXpMLgVWdHjLSYsns1jsacdBgfQFRgdEslR605HA0H65G9DYwgS-8YehgjaxGWEWBz1yHb-6dtWQ8no6mXE8xH6tKBApAcTuOZ0oEnrcWAzF2Bn-Fr21IqvEPbl2ReUaDnlz7vMN1dP5upquIj9c3ofTTr4jaGCMnZU3dePX71czqNmU_wxU-a9rgymTke6XBiR6XrstC1w2Rdw";

const p2Title = attrs.pillar2Title || "Zerstörungsfreie Prüfung (ZfP / VT, PT, MT, UT, RT)";
const p2Desc = attrs.pillar2Desc || "Zertifizierte Inspektionen durch Personal der Stufen II und III gemäß ISO 9712.";
const p2Img = getMedia(attrs.pillar2Image, pageData) || "https://lh3.googleusercontent.com/aida-public/AB6AXuBBrGiolNSi1aj_eMj1dC52n6Fhn9p1dzew3rJjbium6Hcp0su75LUGgByvEvfD7gzxGp6dkOqMh4sDXy5yUXgpQujccUM6Igb5FOBweEzo5oiELmnPTZFp3HeqCcWxzH0JlyKhYpKb8AN_yCCzbt_697NM4eYFHYx68s0z4LxT19W_czhbgEk9HExO1APRQli5cfWmoCZdipk2ZqcVJQfAEZCl3VJwEXF1keSSA4XtPYcoMlMFW7uZeRnGsvWpOY63Kbj49EQHhV8";

const p3Title = attrs.pillar3Title || "Korrosionsschutz & FROSIO/NACE-Inspektion";
const p3Desc = attrs.pillar3Desc || "Umfassende Beschichtungsinspektionen, Analyse der Oberflächenvorbereitung und Qualitätssicherung.";
const p3Img = getMedia(attrs.pillar3Image, pageData) || "https://lh3.googleusercontent.com/aida-public/AB6AXuBBrGiolNSi1aj_eMj1dC52n6Fhn9p1dzew3rJjbium6Hcp0su75LUGgByvEvfD7gzxGp6dkOqMh4sDXy5yUXgpQujccUM6Igb5FOBweEzo5oiELmnPTZFp3HeqCcWxzH0JlyKhYpKb8AN_yCCzbt_697NM4eYFHYx68s0z4LxT19W_czhbgEk9HExO1APRQli5cfWmoCZdipk2ZqcVJQfAEZCl3VJwEXF1keSSA4XtPYcoMlMFW7uZeRnGsvWpOY63Kbj49EQHhV8";
---
<Layout title={title} seoTitle={seoTitle} seoDescription={seoDesc} lang="de">
  <!-- Hero Section -->
  <section class="relative min-h-[520px] flex items-center overflow-hidden bg-navy py-20">
    <div class="relative z-10 px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto w-full">
      <div class="max-w-2xl">
        <span class="font-label-md text-secondary bg-white/10 px-3 py-1 rounded-full mb-6 inline-block tracking-wider uppercase font-bold">{badge}</span>
        <h1 class="font-display text-4xl md:text-6xl font-bold text-white mb-6 leading-tight" set:html={heroTitle} />
        <p class="font-body-md text-lg text-gray-300 max-w-xl leading-relaxed" set:html={heroDesc} />
      </div>
    </div>
    <div class="absolute bottom-0 right-0 p-margin-desktop hidden lg:block pointer-events-none">
      <div class="w-64 h-64 border border-white/10 industrial-grid opacity-20"></div>
    </div>
  </section>

  <!-- Main Pillars -->
  <section class="py-24 px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto">
    <div class="grid grid-cols-1 gap-16 md:gap-24">
      <!-- Pillar 1: Welding -->
      <div class="group grid md:grid-cols-12 gap-12 items-center border-b border-outline-variant/30 pb-16">
        <div class="md:col-span-5">
          <div class="aspect-video bg-surface-container rounded-xl overflow-hidden border border-outline-variant/30 group-hover:border-primary transition-all shadow-md">
            <img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" src={p1Img} alt={p1Title} />
          </div>
        </div>
        <div class="md:col-span-7">
          <div class="flex items-center gap-4 mb-6">
            <div class="w-12 h-12 bg-surface-container flex items-center justify-center rounded-lg border border-outline-variant/30 text-primary group-hover:bg-primary group-hover:text-white transition-all shadow-sm">
              <span class="material-symbols-outlined text-2xl">precision_manufacturing</span>
            </div>
            <h2 class="font-display text-2xl md:text-3xl font-bold text-primary">{p1Title}</h2>
          </div>
          <div class="text-on-surface-variant font-body-md mb-8 leading-relaxed prose max-w-none" set:html={p1Desc} />
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div class="flex items-start gap-3 bg-surface-container/50 p-4 rounded-lg border border-outline-variant/20">
              <span class="material-symbols-outlined text-secondary mt-0.5">check_circle</span>
              <div>
                <h4 class="font-bold text-on-surface text-sm">ISO 3834</h4>
                <p class="text-xs text-on-surface-variant mt-0.5">Vollständige Einhaltung der internationalen Schweißqualitätsanforderungen.</p>
              </div>
            </div>
            <div class="flex items-start gap-3 bg-surface-container/50 p-4 rounded-lg border border-outline-variant/20">
              <span class="material-symbols-outlined text-secondary mt-0.5">check_circle</span>
              <div>
                <h4 class="font-bold text-on-surface text-sm">EN 1090</h4>
                <p class="text-xs text-on-surface-variant mt-0.5">Fachkundige Überwachung der Herstellung von Stahlkonstruktionen.</p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Pillar 2: NDT -->
      <div class="group grid md:grid-cols-12 gap-12 items-center border-b border-outline-variant/30 pb-16">
        <div class="md:col-span-7 order-2 md:order-1">
          <div class="flex items-center gap-4 mb-6">
            <div class="w-12 h-12 bg-surface-container flex items-center justify-center rounded-lg border border-outline-variant/30 text-primary group-hover:bg-primary group-hover:text-white transition-all shadow-sm">
              <span class="material-symbols-outlined text-2xl">visibility</span>
            </div>
            <h2 class="font-display text-2xl md:text-3xl font-bold text-primary">{p2Title}</h2>
          </div>
          <div class="text-on-surface-variant font-body-md mb-8 leading-relaxed prose max-w-none" set:html={p2Desc} />
          <div class="flex flex-wrap gap-2.5">
            <span class="px-3.5 py-1.5 bg-surface-container rounded-full text-xs font-bold border border-outline-variant/30 text-on-surface">VT - Visuell</span>
            <span class="px-3.5 py-1.5 bg-surface-container rounded-full text-xs font-bold border border-outline-variant/30 text-on-surface">PT - Eindringprüfung</span>
            <span class="px-3.5 py-1.5 bg-surface-container rounded-full text-xs font-bold border border-outline-variant/30 text-on-surface">MT - Magnetpulver</span>
            <span class="px-3.5 py-1.5 bg-surface-container rounded-full text-xs font-bold border border-outline-variant/30 text-on-surface">UT - Ultraschall</span>
            <span class="px-3.5 py-1.5 bg-surface-container rounded-full text-xs font-bold border border-outline-variant/30 text-on-surface">RT - Radiographie</span>
          </div>
        </div>
        <div class="md:col-span-5 order-1 md:order-2">
          <div class="aspect-video bg-surface-container rounded-xl overflow-hidden border border-outline-variant/30 group-hover:border-primary transition-all shadow-md">
            <img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" src={p2Img} alt={p2Title} />
          </div>
        </div>
      </div>

      <!-- Pillar 3: Corrosion Protection -->
      <div class="group grid md:grid-cols-12 gap-12 items-center">
        <div class="md:col-span-5">
          <div class="aspect-video bg-surface-container rounded-xl overflow-hidden border border-outline-variant/30 group-hover:border-primary transition-all shadow-md">
            <img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" src={p3Img} alt={p3Title} />
          </div>
        </div>
        <div class="md:col-span-7">
          <div class="flex items-center gap-4 mb-6">
            <div class="w-12 h-12 bg-surface-container flex items-center justify-center rounded-lg border border-outline-variant/30 text-primary group-hover:bg-primary group-hover:text-white transition-all shadow-sm">
              <span class="material-symbols-outlined text-2xl">layers</span>
            </div>
            <h2 class="font-display text-2xl md:text-3xl font-bold text-primary">{p3Title}</h2>
          </div>
          <div class="text-on-surface-variant font-body-md mb-8 leading-relaxed prose max-w-none" set:html={p3Desc} />
          <ul class="space-y-2.5">
            <li class="flex items-center gap-3 text-sm text-on-surface font-medium">
              <span class="w-2 h-2 bg-secondary rounded-full"></span>
              Überprüfung der Oberflächenreinheit und des Rauheitsprofils
            </li>
            <li class="flex items-center gap-3 text-sm text-on-surface font-medium">
              <span class="w-2 h-2 bg-secondary rounded-full"></span>
              Überwachung der klimatischen Bedingungen während der Applikation
            </li>
            <li class="flex items-center gap-3 text-sm text-on-surface font-medium">
              <span class="w-2 h-2 bg-secondary rounded-full"></span>
              Messung der Schichtdicke und Haftfestigkeit
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Technical Support Section -->
  <section class="bg-surface-container-low py-20 border-y border-outline-variant/30">
    <div class="px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto">
      <div class="text-center mb-14">
        <h2 class="font-display text-3xl font-bold mb-3 text-primary">Bereiche der technischen Unterstützung</h2>
        <p class="text-on-surface-variant max-w-2xl mx-auto text-sm md:text-base">Zusätzliche Ingenieurkompetenzen zur Unterstützung wichtiger Industrieprojekte.</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-6">
        <div class="bg-surface p-6 rounded-xl border border-outline-variant/30 hover:border-primary transition-all flex flex-col items-center text-center shadow-sm">
          <span class="material-symbols-outlined text-3xl mb-3 text-secondary">verified</span>
          <h3 class="font-bold text-base mb-1">QA/QC</h3>
          <p class="text-xs text-on-surface-variant leading-relaxed">Qualitätssicherung und -kontrolle in jeder Phase der Fertigung.</p>
        </div>
        <div class="bg-surface p-6 rounded-xl border border-outline-variant/30 hover:border-primary transition-all flex flex-col items-center text-center shadow-sm">
          <span class="material-symbols-outlined text-3xl mb-3 text-secondary">rule</span>
          <h3 class="font-bold text-base mb-1">QS/QM</h3>
          <p class="text-xs text-on-surface-variant leading-relaxed">Systemisches Sicherheits- und Qualitätsmanagement.</p>
        </div>
        <div class="bg-surface p-6 rounded-xl border border-outline-variant/30 hover:border-primary transition-all flex flex-col items-center text-center shadow-sm">
          <span class="material-symbols-outlined text-3xl mb-3 text-secondary">description</span>
          <h3 class="font-bold text-base mb-1">Dokumentation</h3>
          <p class="text-xs text-on-surface-variant leading-relaxed">Vollständige Erstellung technischer Bestandsdokumentationen.</p>
        </div>
        <div class="bg-surface p-6 rounded-xl border border-outline-variant/30 hover:border-primary transition-all flex flex-col items-center text-center shadow-sm">
          <span class="material-symbols-outlined text-3xl mb-3 text-secondary">engineering</span>
          <h3 class="font-bold text-base mb-1">Engineering</h3>
          <p class="text-xs text-on-surface-variant leading-relaxed">Ingenieurtechnische Unterstützung bei der Prozessoptimierung.</p>
        </div>
        <div class="bg-surface p-6 rounded-xl border border-outline-variant/30 hover:border-primary transition-all flex flex-col items-center text-center shadow-sm">
          <span class="material-symbols-outlined text-3xl mb-3 text-secondary">account_tree</span>
          <h3 class="font-bold text-base mb-1">Koordination</h3>
          <p class="text-xs text-on-surface-variant leading-relaxed">Terminmanagement und interdisziplinäre Koordination.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-20 px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto text-center">
    <div class="bg-navy text-white rounded-2xl p-10 md:p-16 relative overflow-hidden shadow-xl">
      <div class="absolute inset-0 industrial-grid opacity-10"></div>
      <div class="relative z-10 max-w-2xl mx-auto">
        <h2 class="font-display text-3xl md:text-4xl font-bold mb-4">Benötigen Sie technische Expertise?</h2>
        <p class="text-gray-300 mb-8 leading-relaxed">Kontaktieren Sie unseren Hauptsitz in Bremen, um Ihre Projektanforderungen zu besprechen und eine individuelle Lösung zu erhalten.</p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/de/kontakt" class="bg-secondary text-white px-8 py-3.5 rounded-lg font-bold hover:opacity-90 transition-all shadow-md">Angebot anfordern</a>
          <a href="/de/about" class="border border-white/40 text-white px-8 py-3.5 rounded-lg font-bold hover:bg-white hover:text-navy transition-all">Mehr über uns erfahren</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
