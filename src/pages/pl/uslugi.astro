---
import Layout from '../../layouts/Layout.astro';
import { fetchApi, getMedia } from '../../lib/data';

const pageData = await fetchApi({
  collection: 'services_page',
  locale: 'pl'
});

const attrs = pageData || {};
const title = attrs.title || "Usługi";
const seoTitle = attrs.seoTitle || "Usługi | ASN Weld & Inspection Network";
const seoDesc = attrs.seoDesc || "Kompleksowe wsparcie techniczne w zakresie spawalnictwa, badań nieniszczących oraz ochrony antykorozyjnej.";

const badge = attrs.badge || "PROFESJONALIZM I JAKOŚĆ";
const heroTitle = attrs.heroTitle || "Nasze Usługi";
const heroDesc = attrs.heroDesc || "Kompleksowe wsparcie techniczne w zakresie spawalnictwa, badań nieniszczących oraz ochrony antykorozyjnej dla przemysłu ciężkiego i energetyki.";

const p1Title = attrs.pillar1Title || "Koordynacja i Nadzór Spawalniczy (IWE/EWE)";
const p1Desc = attrs.pillar1Desc || "Pełny nadzór nad procesami spawania zgodnie z normami EN ISO 3834, EN 1090 oraz standardami offshore.";
const p1Img = getMedia(attrs.pillar1Image, pageData) || "https://lh3.googleusercontent.com/aida-public/AB6AXuCozDnJai0fc5h24His7_lwuuvRkWNw7ycEntToxRTQvtqihRfEzRqgqf9dkI9NuXpMLgVWdHjLSYsns1jsacdBgfQFRgdEslR605HA0H65G9DYwgS-8YehgjaxGWEWBz1yHb-6dtWQ8no6mXE8xH6tKBApAcTuOZ0oEnrcWAzF2Bn-Fr21IqvEPbl2ReUaDnlz7vMN1dP5upquIj9c3ofTTr4jaGCMnZU3dePX71czqNmU_wxU-a9rgymTke6XBiR6XrstC1w2Rdw";

const p2Title = attrs.pillar2Title || "Badania Nieniszczące (NDT / VT, PT, MT, UT, RT)";
const p2Desc = attrs.pillar2Desc || "Certyfikowane inspekcje wykonywane przez personel drugiego i trzeciego stopnia według normy ISO 9712.";
const p2Img = getMedia(attrs.pillar2Image, pageData) || "https://images.unsplash.com/photo-1581092160607-ee22621dd758?auto=format&fit=crop&q=80&w=800";

const p3Title = attrs.pillar3Title || "Ochrona Antykorozyjna i Inspekcje FROSIO/NACE";
const p3Desc = attrs.pillar3Desc || "Kompleksowe inspekcje powłok malarskich, analiza przygotowania powierzchni i kontrola jakości.";
const p3Img = getMedia(attrs.pillar3Image, pageData) || "https://images.unsplash.com/photo-1504917599217-d4dc5ebe6122?auto=format&fit=crop&q=80&w=800";
---
<Layout title={title} seoTitle={seoTitle} seoDescription={seoDesc} lang="pl">
  <!-- Hero Section -->
  <section class="relative min-h-[520px] flex items-center overflow-hidden bg-navy py-20">
    <div class="relative z-10 px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto w-full">
      <div class="max-w-2xl">
        <span class="font-label-md text-secondary bg-white/10 px-3 py-1 rounded-full mb-6 inline-block tracking-wider uppercase font-bold">{badge}</span>
        <h1 class="font-display text-4xl md:text-6xl font-bold text-white mb-6 leading-tight" set:html={heroTitle} />
        <p class="font-body-md text-lg text-gray-300 max-w-xl leading-relaxed" set:html={heroDesc} />
      </div>
    </div>
    <div class="absolute bottom-0 right-0 p-margin-desktop hidden lg:block pointer-events-none">
      <div class="w-64 h-64 border border-white/10 industrial-grid opacity-20"></div>
    </div>
  </section>

  <!-- Main Pillars -->
  <section class="py-24 px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto">
    <div class="grid grid-cols-1 gap-16 md:gap-24">
      <!-- Pillar 1: Welding -->
      <div class="group grid md:grid-cols-12 gap-12 items-center border-b border-outline-variant/30 pb-16">
        <div class="md:col-span-5">
          <div class="aspect-video bg-surface-container rounded-xl overflow-hidden border border-outline-variant/30 group-hover:border-primary transition-all shadow-md">
            <img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" src={p1Img} alt={p1Title} />
          </div>
        </div>
        <div class="md:col-span-7">
          <div class="flex items-center gap-4 mb-6">
            <div class="w-12 h-12 bg-surface-container flex items-center justify-center rounded-lg border border-outline-variant/30 text-primary group-hover:bg-primary group-hover:text-white transition-all shadow-sm">
              <span class="material-symbols-outlined text-2xl">precision_manufacturing</span>
            </div>
            <h2 class="font-display text-2xl md:text-3xl font-bold text-primary">{p1Title}</h2>
          </div>
          <div class="text-on-surface-variant font-body-md mb-8 leading-relaxed prose max-w-none" set:html={p1Desc} />
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div class="flex items-start gap-3 bg-surface-container/50 p-4 rounded-lg border border-outline-variant/20">
              <span class="material-symbols-outlined text-secondary mt-0.5">check_circle</span>
              <div>
                <h4 class="font-bold text-on-surface text-sm">ISO 3834</h4>
                <p class="text-xs text-on-surface-variant mt-0.5">Pełna zgodność z międzynarodowymi normami jakościowymi.</p>
              </div>
            </div>
            <div class="flex items-start gap-3 bg-surface-container/50 p-4 rounded-lg border border-outline-variant/20">
              <span class="material-symbols-outlined text-secondary mt-0.5">check_circle</span>
              <div>
                <h4 class="font-bold text-on-surface text-sm">EN 1090</h4>
                <p class="text-xs text-on-surface-variant mt-0.5">Ekspercki nadzór nad wykonaniem konstrukcji stalowych.</p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Pillar 2: NDT -->
      <div class="group grid md:grid-cols-12 gap-12 items-center border-b border-outline-variant/30 pb-16">
        <div class="md:col-span-7 order-2 md:order-1">
          <div class="flex items-center gap-4 mb-6">
            <div class="w-12 h-12 bg-surface-container flex items-center justify-center rounded-lg border border-outline-variant/30 text-primary group-hover:bg-primary group-hover:text-white transition-all shadow-sm">
              <span class="material-symbols-outlined text-2xl">visibility</span>
            </div>
            <h2 class="font-display text-2xl md:text-3xl font-bold text-primary">{p2Title}</h2>
          </div>
          <div class="text-on-surface-variant font-body-md mb-8 leading-relaxed prose max-w-none" set:html={p2Desc} />
          <div class="flex flex-wrap gap-2.5">
            <span class="px-3.5 py-1.5 bg-surface-container rounded-full text-xs font-bold border border-outline-variant/30 text-on-surface">VT - Wizualne</span>
            <span class="px-3.5 py-1.5 bg-surface-container rounded-full text-xs font-bold border border-outline-variant/30 text-on-surface">PT - Penetracyjne</span>
            <span class="px-3.5 py-1.5 bg-surface-container rounded-full text-xs font-bold border border-outline-variant/30 text-on-surface">MT - Magnetyczno-proszkowe</span>
            <span class="px-3.5 py-1.5 bg-surface-container rounded-full text-xs font-bold border border-outline-variant/30 text-on-surface">UT - Ultradźwiękowe</span>
            <span class="px-3.5 py-1.5 bg-surface-container rounded-full text-xs font-bold border border-outline-variant/30 text-on-surface">RT - Radiograficzne</span>
          </div>
        </div>
        <div class="md:col-span-5 order-1 md:order-2">
          <div class="aspect-video bg-surface-container rounded-xl overflow-hidden border border-outline-variant/30 group-hover:border-primary transition-all shadow-md">
            <img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" src={p2Img} alt={p2Title} />
          </div>
        </div>
      </div>

      <!-- Pillar 3: Corrosion Protection -->
      <div class="group grid md:grid-cols-12 gap-12 items-center">
        <div class="md:col-span-5">
          <div class="aspect-video bg-surface-container rounded-xl overflow-hidden border border-outline-variant/30 group-hover:border-primary transition-all shadow-md">
            <img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" src={p3Img} alt={p3Title} />
          </div>
        </div>
        <div class="md:col-span-7">
          <div class="flex items-center gap-4 mb-6">
            <div class="w-12 h-12 bg-surface-container flex items-center justify-center rounded-lg border border-outline-variant/30 text-primary group-hover:bg-primary group-hover:text-white transition-all shadow-sm">
              <span class="material-symbols-outlined text-2xl">layers</span>
            </div>
            <h2 class="font-display text-2xl md:text-3xl font-bold text-primary">{p3Title}</h2>
          </div>
          <div class="text-on-surface-variant font-body-md mb-8 leading-relaxed prose max-w-none" set:html={p3Desc} />
          <ul class="space-y-2.5">
            <li class="flex items-center gap-3 text-sm text-on-surface font-medium">
              <span class="w-2 h-2 bg-secondary rounded-full"></span>
              Kontrola czystości podłoża i profilu chropowatości
            </li>
            <li class="flex items-center gap-3 text-sm text-on-surface font-medium">
              <span class="w-2 h-2 bg-secondary rounded-full"></span>
              Pomiary warunków klimatycznych podczas aplikacji
            </li>
            <li class="flex items-center gap-3 text-sm text-on-surface font-medium">
              <span class="w-2 h-2 bg-secondary rounded-full"></span>
              Weryfikacja grubości powłok i przyczepności
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Technical Support Section -->
  <section class="bg-surface-container-low py-20 border-y border-outline-variant/30">
    <div class="px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto">
      <div class="text-center mb-14">
        <h2 class="font-display text-3xl font-bold mb-3 text-primary">Obszary Wsparcia Technicznego</h2>
        <p class="text-on-surface-variant max-w-2xl mx-auto text-sm md:text-base">Dodatkowe kompetencje wspierające realizację kluczowych projektów inżynieryjnych.</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-6">
        <div class="bg-surface p-6 rounded-xl border border-outline-variant/30 hover:border-primary transition-all flex flex-col items-center text-center shadow-sm">
          <span class="material-symbols-outlined text-3xl mb-3 text-secondary">verified</span>
          <h3 class="font-bold text-base mb-1">QA/QC</h3>
          <p class="text-xs text-on-surface-variant leading-relaxed">Zapewnienie i kontrola jakości na każdym etapie produkcji.</p>
        </div>
        <div class="bg-surface p-6 rounded-xl border border-outline-variant/30 hover:border-primary transition-all flex flex-col items-center text-center shadow-sm">
          <span class="material-symbols-outlined text-3xl mb-3 text-secondary">rule</span>
          <h3 class="font-bold text-base mb-1">QS/QM</h3>
          <p class="text-xs text-on-surface-variant leading-relaxed">Systemowe zarządzanie bezpieczeństwem i jakością.</p>
        </div>
        <div class="bg-surface p-6 rounded-xl border border-outline-variant/30 hover:border-primary transition-all flex flex-col items-center text-center shadow-sm">
          <span class="material-symbols-outlined text-3xl mb-3 text-secondary">description</span>
          <h3 class="font-bold text-base mb-1">Dokumentacja</h3>
          <p class="text-xs text-on-surface-variant leading-relaxed">Kompletne opracowanie dokumentacji powykonawczej.</p>
        </div>
        <div class="bg-surface p-6 rounded-xl border border-outline-variant/30 hover:border-primary transition-all flex flex-col items-center text-center shadow-sm">
          <span class="material-symbols-outlined text-3xl mb-3 text-secondary">engineering</span>
          <h3 class="font-bold text-base mb-1">Inżynieria</h3>
          <p class="text-xs text-on-surface-variant leading-relaxed">Wsparcie inżynieryjne przy optymalizacji procesów.</p>
        </div>
        <div class="bg-surface p-6 rounded-xl border border-outline-variant/30 hover:border-primary transition-all flex flex-col items-center text-center shadow-sm">
          <span class="material-symbols-outlined text-3xl mb-3 text-secondary">account_tree</span>
          <h3 class="font-bold text-base mb-1">Koordynacja</h3>
          <p class="text-xs text-on-surface-variant leading-relaxed">Zarządzanie terminami i koordynacja międzybranżowa.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-20 px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto text-center">
    <div class="bg-navy text-white rounded-2xl p-10 md:p-16 relative overflow-hidden shadow-xl">
      <div class="absolute inset-0 industrial-grid opacity-10"></div>
      <div class="relative z-10 max-w-2xl mx-auto">
        <h2 class="font-display text-3xl md:text-4xl font-bold mb-4">Potrzebujesz ekspertyzy technicznej?</h2>
        <p class="text-gray-300 mb-8 leading-relaxed">Skontaktuj się z naszą centralą w Bremie, aby omówić wymagania Twojego projektu i otrzymać indywidualną wycenę.</p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/pl/kontakt.html" class="bg-secondary text-white px-8 py-3.5 rounded-lg font-bold hover:opacity-90 transition-all shadow-md">Zapytaj o ofertę</a>
          <a href="/pl/about.html" class="border border-white/40 text-white px-8 py-3.5 rounded-lg font-bold hover:bg-white hover:text-navy transition-all">Poznaj nas bliżej</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
