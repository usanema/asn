---
import Layout from '../layouts/Layout.astro';
import { fetchApi, getMedia } from '../lib/pocketbase';

const pageData = await fetchApi({
  collection: 'experience_page',
  locale: 'en'
});

const attrs = pageData || {};
const title = attrs.title || "Experience";
const seoTitle = attrs.seoTitle || "Experience | ASN Weld & Inspection Network";
const seoDesc = attrs.seoDesc || "Learn about our experience and technical responsibility model.";

const badge = attrs.badge || "OUR IDENTITY";
const heroTitle = attrs.heroTitle || "Knowledge, Experience, Responsibility.";
const heroDesc = attrs.heroDesc || "ASN Weld & Inspection Network is a team of experts dedicated to the welding and NDT industry. We deliver complete technical solutions based on the highest engineering standards.";

const modelTitle = attrs.modelTitle || "Cooperation Model: Werkvertrag & Outsourcing";
const modelDesc = attrs.modelDesc || "<p class=\"mb-4\">Our business model is based on service contracts (Werkvertrag) and full technical process outsourcing. We take full responsibility for the final project result, weld quality, and compliance with NDT standards.</p>";

const s1Val = attrs.stat1Val || "15+";
const s1Lbl = attrs.stat1Lbl || "Years in Offshore Industry";
const s2Val = attrs.stat2Val || "100%";
const s2Lbl = attrs.stat2Lbl || "Compliance with EN/ISO";
const s3Val = attrs.stat3Val || "50+";
const s3Lbl = attrs.stat3Lbl || "Completed Major Projects";

const img1 = getMedia(attrs.image1, pageData) || "https://images.unsplash.com/photo-1541888946425-d0abb18086f6?auto=format&fit=crop&q=80&w=800";
const hqImg = "https://lh3.googleusercontent.com/aida-public/AB6AXuAdqFr86OltPylJyJf6vgZTVDTHJhEFfvb6ORZ-L7YL9hprkzbr3hdjRBiSG6_6n8I3tb20w3oRRVOkrpAzqW-u1OSNcSvJ0uaR2b_68qRH0HGJXgdqt1AOF8UvbKcnBEN99JuPQj7IaDsnDmNeqvAC59rL4u3bKq7ugRGDZ3OO0VaySi7Eyr-v-r6WZKftMgMzcbOIHMfZBh027NBW2hT2GmaNifIAbOHkGnuhAqicMIu7G2EssENST3VHpP1OqY5QvrZO8nDgd4c";
---
<Layout title={title} seoTitle={seoTitle} seoDescription={seoDesc} lang="en">
  <!-- Hero Section -->
  <section class="relative py-20 md:py-28 bg-navy text-white overflow-hidden border-b border-outline-variant/30">
    <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop relative z-10">
      <div class="max-w-3xl">
        <span class="font-display text-sm font-bold text-secondary tracking-widest uppercase mb-4 block">{badge}</span>
        <h1 class="font-display text-4xl md:text-6xl font-bold mb-8 leading-tight" set:html={heroTitle} />
        <p class="font-body-md text-lg text-gray-300 mb-10 border-l-4 border-secondary pl-6 leading-relaxed" set:html={heroDesc} />
      </div>
    </div>
  </section>

  <!-- Stats Banner -->
  <section class="bg-surface-container py-12 border-b border-outline-variant/30">
    <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-center">
        <div class="p-6 bg-surface rounded-xl border border-outline-variant/20 shadow-sm">
          <div class="font-display text-4xl md:text-5xl font-extrabold text-primary mb-2">{s1Val}</div>
          <div class="text-sm font-bold text-on-surface-variant uppercase tracking-wider">{s1Lbl}</div>
        </div>
        <div class="p-6 bg-surface rounded-xl border border-outline-variant/20 shadow-sm">
          <div class="font-display text-4xl md:text-5xl font-extrabold text-primary mb-2">{s2Val}</div>
          <div class="text-sm font-bold text-on-surface-variant uppercase tracking-wider">{s2Lbl}</div>
        </div>
        <div class="p-6 bg-surface rounded-xl border border-outline-variant/20 shadow-sm">
          <div class="font-display text-4xl md:text-5xl font-extrabold text-primary mb-2">{s3Val}</div>
          <div class="text-sm font-bold text-on-surface-variant uppercase tracking-wider">{s3Lbl}</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Cooperation Model Section -->
  <section class="py-24 bg-surface">
    <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-16 items-center">
        <div>
          <h2 class="font-display text-3xl md:text-4xl font-bold text-primary mb-6">{modelTitle}</h2>
          <div class="font-body-md text-base text-on-surface-variant mb-8 leading-relaxed prose max-w-none" set:html={modelDesc} />
          <div class="space-y-4">
            <div class="flex items-start gap-4 p-5 bg-surface-container-low rounded-xl border border-outline-variant/30">
              <span class="material-symbols-outlined text-secondary text-3xl">assignment_turned_in</span>
              <div>
                <h4 class="font-display font-bold text-primary mb-1">PROJECT-ORIENTED APPROACH</h4>
                <p class="text-sm text-on-surface-variant">Focus on delivering specific technical milestones within agreed timelines and standards.</p>
              </div>
            </div>
            <div class="flex items-start gap-4 p-5 bg-surface-container-low rounded-xl border border-outline-variant/30">
              <span class="material-symbols-outlined text-secondary text-3xl">verified_user</span>
              <div>
                <h4 class="font-display font-bold text-primary mb-1">QUALITY GUARANTEE</h4>
                <p class="text-sm text-on-surface-variant">Dedicated engineering supervision and certified inspectors present at every critical phase.</p>
              </div>
            </div>
          </div>
        </div>
        <div class="relative aspect-square rounded-2xl overflow-hidden shadow-xl border border-outline-variant/30">
          <img class="w-full h-full object-cover" src={img1} alt={modelTitle} />
          <div class="absolute bottom-6 left-6 right-6 bg-navy/95 backdrop-blur-md p-6 rounded-xl border border-white/10 hidden sm:block">
            <p class="text-white font-display text-lg font-bold">0% Staffing Agency<br/><span class="text-secondary font-normal">100% Engineering Responsibility</span></p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Why ASN Section -->
  <section class="py-20 bg-surface-container-low border-t border-outline-variant/30">
    <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop">
      <div class="text-center mb-14">
        <h2 class="font-display text-3xl font-bold text-primary mb-3">Why Choose ASN?</h2>
        <p class="text-on-surface-variant max-w-xl mx-auto">Our competitive edge lies in practical industry experience and unwavering quality.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="bg-surface p-8 rounded-xl border border-outline-variant/30 shadow-sm">
          <div class="w-12 h-1 bg-secondary mb-6"></div>
          <h3 class="font-display text-xl font-bold text-primary mb-3">Flexibility</h3>
          <p class="text-sm text-on-surface-variant leading-relaxed">We adapt our engineering team size and competencies to current project phases, optimizing client fixed operational overhead.</p>
        </div>
        <div class="bg-surface p-8 rounded-xl border border-outline-variant/30 shadow-sm">
          <div class="w-12 h-1 bg-secondary mb-6"></div>
          <h3 class="font-display text-xl font-bold text-primary mb-3">Reliability</h3>
          <p class="text-sm text-on-surface-variant leading-relaxed">Every technical report and inspection signed by ASN undergoes rigorous internal verification against applicable EN/ISO codes.</p>
        </div>
        <div class="bg-surface p-8 rounded-xl border border-outline-variant/30 shadow-sm">
          <div class="w-12 h-1 bg-secondary mb-6"></div>
          <h3 class="font-display text-xl font-bold text-primary mb-3">Industry Practice</h3>
          <p class="text-sm text-on-surface-variant leading-relaxed">Our knowledge is rooted in practical offshore, shipbuilding, and energy sector executions, not just academic theory.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Headquarters Section -->
  <section class="py-20 bg-navy text-white">
    <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-stretch rounded-2xl overflow-hidden border border-white/10 shadow-2xl">
        <div class="bg-cover bg-center min-h-[350px]" style={`background-image: url('${hqImg}')`}></div>
        <div class="p-10 md:p-16 flex flex-col justify-center bg-navy">
          <span class="text-secondary font-bold text-xs uppercase tracking-wider mb-2">Central Operations</span>
          <h2 class="font-display text-3xl font-bold text-white mb-6">Bremen Headquarters</h2>
          <p class="text-gray-300 mb-8 leading-relaxed">
            Our strategic command center is situated in Bremen, one of Europe's premier maritime and industrial hubs. From here, we coordinate operations across European markets, managing technical logistics and compliance for every project.
          </p>
          <div class="flex items-center gap-6 pt-6 border-t border-white/10">
            <div>
              <span class="text-xs font-bold uppercase text-gray-400 block mb-1">Location</span>
              <span class="text-white font-bold">Bremen, Germany</span>
            </div>
            <div class="w-px h-10 bg-white/20"></div>
            <div>
              <span class="text-xs font-bold uppercase text-gray-400 block mb-1">Quality Standards</span>
              <span class="text-secondary font-bold">ISO & ASME Compliant</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
